# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Debug screenshots and scratch output from device testing (adb screencap).
# These are throwaway artefacts of a session, not project files.
/*.png
/build.log
/export.log
/bundle_test.js
/b2.js
/audit_fixes.json
/bugs.json
/rules.json

# Firebase config for FCM. The API key inside is not a password, but it is
# project-identifying and the repo may be public — the file only needs to exist
# on the machine that builds. If EAS Build (cloud) is ever used, upload it there
# as a file secret instead of committing it.
google-services.json

# Built APKs. The folder and its README are tracked; the binaries are not —
# a release APK is ~70 MB and a new one is produced on every build.
/apk/*.apk
.i18n-test/
__pycache__/

# The concurrency harness's last live report: real ids of the run (gyms, day
# passes, the owner's test account) — output of a run, not a project file.
/scripts/sim/last-report.json

# Play bundles are build output, and 95 MB each.
/apk/*.aab

# The public website is assembled by web/build-site.mjs from web/landing
# and store/legal — never edited by hand, never committed.
/web/public/
